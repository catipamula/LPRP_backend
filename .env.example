# ==========================================
# Smart City Portal - Backend Environment Variables
# ==========================================

# Django Configuration
DJANGO_SECRET_KEY=smart-city-resolver-production-key-2026
DEBUG=True

# Application URLs
FRONTEND_URL=http://localhost:5175

# ==========================================
# SMTP Email Notification Settings
# ==========================================
# Set EMAIL_BACKEND to 'smtp' for live email dispatch or 'console' for local testing
EMAIL_BACKEND=smtp

# SMTP Provider (e.g., smtp.gmail.com, smtp.office365.com, email-smtp.us-east-1.amazonaws.com)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10

# SMTP Authentication (Use App Password for Gmail / 2FA)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Sender Identity
DEFAULT_FROM_EMAIL=Smart City Portal <noreply@smartcity.gov.in>
